FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy dependencies specific to frontend or shared requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Create app user
RUN useradd -m -u 1000 appuser && \
    mkdir -p logs && \
    chown -R appuser:appuser /app

COPY --chown=appuser:appuser app/frontend/ ./app/frontend/
COPY --chown=appuser:appuser src/ ./src/

USER appuser

ENV PYTHONPATH=/app
ENV BACKEND_API_URL=http://backend:8000/api/v1
ENV STREAMLIT_SERVER_PORT=8501
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "app/frontend/Home.py", "--server.port=8501", "--server.address=0.0.0.0"]