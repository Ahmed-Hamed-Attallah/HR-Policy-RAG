# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Backend & API Configuration
BACKEND_API_URL=http://localhost:8000/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# ==============================================================================
# LLM Execution Mode & Provider Configuration
# ==============================================================================
# API_BASED: True للاعتماد على APIs خارجية (OpenAI, Groq, etc.)
# API_BASED: False لتشغيل نماذج محلية ومجانية تماماً عبر Hugging Face Transformers
API_BASED=True

# مزود الخدمة عند تفعيل API_BASED=True (e.g., "openai", "groq")
API_PROVIDER=openai

# رابط الـ Endpoint للـ API (يُترك فارغاً لـ OpenAI الرسمي، أو يُحدد لـ Groq/المحليات)
# مثال لـ Groq: https://api.groq.com/openai/v1
API_BASE_URL=

# مفتاح الـ API (اتركه فارغاً إذا كان API_BASED=False)
MODEL_API=your-api-key-here

# اسم النموذج المستخدم:
# إذا كان API_BASED=True: (e.g., "gpt-4o-mini", "llama-3.1-8b-instant")
# إذا كان API_BASED=False: اسم نموذج Hugging Face (e.g., "Qwen/Qwen2.5-1.5B-Instruct", "microsoft/Phi-3-mini-4k-instruct")
MODEL_NAME=gpt-4o-mini

# معايير التوليد
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# ==============================================================================
# Embeddings & Reranker Configuration
# ==============================================================================
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage & Artifact Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
ARTIFACTS_DIR=artifacts
VECTOR_INDEX_PATH=artifacts/faiss_index.bin
METADATA_STORE_PATH=artifacts/chunks_metadata.json